# Fase 18 (temuan audit lintas-fase, T-109): template ini TIDAK ADA
# sebelumnya — deploy produksi berisiko nyata meng-copy .env.example
# (APP_DEBUG=true, tanpa SESSION_SECURE_COOKIE) apa adanya, membocorkan
# stack trace lengkap (termasuk query SQL) ke publik lewat halaman
# error Laravel. Salin file ini ke `.env` di server produksi (ADR-0008:
# Hostinger shared hosting), isi nilai bertanda WAJIB DIISI, JANGAN
# salin dari .env.example biasa.

APP_NAME="Skillage Mart"
APP_ENV=production
APP_KEY=
# WAJIB DIISI: false. Kalau true di produksi, stack trace (query SQL,
# path server) bocor ke publik lewat halaman error.
APP_DEBUG=false
# WAJIB DIISI: domain sungguhan, https:// (bukan http://).
APP_URL=https://skillagemart.example.com
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# 'error', bukan 'debug' — log produksi tidak perlu detail level dev.
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
# WAJIB DIISI: kredensial database produksi sungguhan.
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# WAJIB DIISI: domain sungguhan (mis. .skillagemart.example.com) —
# null berarti cookie session cuma berlaku di host persis APP_URL.
SESSION_DOMAIN=null
# WAJIB true di produksi (APP_URL sudah https). Guard 'web' DAN
# 'guardian' (Portal Wali) sama-sama pegang data finansial — cookie
# sesi wajib HTTPS-only. config/session.php sudah punya safety net
# (auto-true kalau APP_ENV=production meski baris ini lupa diisi),
# tapi tetap diisi eksplisit di sini supaya jelas bagi siapa pun yang
# deploy.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Shared hosting tanpa Supervisor (ADR-0008) — queue lewat cron polling
# `schedule:run`, bukan worker persisten.
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=null
# WAJIB DIISI: kredensial SMTP produksi sungguhan (mis. dari Hostinger
# atau layanan transactional email).
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@skillagemart.example.com"
MAIL_FROM_NAME="${APP_NAME}"

# WAJIB DIISI: email owner/admin sungguhan — penerima notifikasi
# kegagalan backup harian.
BACKUP_NOTIFICATION_EMAIL=
# Kosongkan — mysqldump sudah ada di PATH standar Linux shared hosting.
MYSQLDUMP_BINARY_PATH=

# Backblaze B2 (S3-compatible) untuk backup offsite (ADR-0008) — isi
# saat kredensial tersedia. Backup lokal SUDAH aktif tanpa ini
# (lihat Fase 17-Darurat, docs/tickets/INDEX.md).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# JANGAN diisi/dijalankan seeder demo di database produksi sungguhan —
# baris ini cuma relevan untuk `php artisan db:seed` di lingkungan
# dev/staging.
SEEDER_DEFAULT_PASSWORD=
SEEDER_DEFAULT_PIN=
