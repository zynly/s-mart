<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- T-105: sengaja MySQL (bukan sqlite default Laravel) — proyek
             ini konsisten pakai fitur MySQL-spesifik di banyak migration
             (mis. `ALTER TABLE ... MODIFY COLUMN ... ENUM(...)`, belum
             pernah ditulis portable ke SQLite). Test DB TERPISAH
             (`s_mart_test`) dari dev (`s_mart_dev`) — RefreshDatabase
             reset isinya tiap run, jangan pernah dipakai untuk data asli. -->
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_DATABASE" value="db-smart"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <!-- Integrasi Midtrans — .env pengembang lokal BOLEH mengisi
             MIDTRANS_GATEWAY ke kelas asli (App\Services\Midtrans\
             MidtransGateway) supaya bisa dites manual lewat browser,
             TAPI test suite otomatis TIDAK BOLEH ikut memanggil API
             sungguhan (lambat, butuh internet, bikin transaksi
             sandbox asli tiap kali `php artisan test` jalan). Paksa
             balik ke NullMidtransGateway khusus utk testing, terlepas
             dari isi .env lokal — pola sama seperti DB_DATABASE di atas. -->
        <env name="MIDTRANS_GATEWAY" value="App\Services\Midtrans\NullMidtransGateway"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
