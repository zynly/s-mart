#!/usr/bin/env bash

# ==============================================================================
# SKILLAGE MART - DESKTOP RELEASE MANAGER TUI SCRIPT
# Inspired by JBR Minpo ./release workflow
# ==============================================================================

# Colors & Formatting
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
MAGENTA='\033[0;35m'
BOLD='\033[1m'
NC='\033[0m' # No Color

SHOW_MENU=true

function print_banner() {
    clear
    echo -e "${CYAN}========================================================================${NC}"
    echo -e "${BOLD}${MAGENTA}       🏪 SKILLAGE MART — DESKTOP RELEASE MANAGER (TUI) ${NC}"
    echo -e "${CYAN}========================================================================${NC}"
    echo -e " Target Platform: ${GREEN}Windows (.exe / .msi)${NC} & ${BLUE}Linux (.AppImage / .deb)${NC}"
    echo -e "${CYAN}========================================================================${NC}"
    echo ""
}

function check_git_status() {
    echo -e "${YELLOW}🔍 Memeriksa status Git repositori...${NC}"
    if [ -n "$(git status --porcelain)" ]; then
        echo -e "${RED}⚠️ Terdapat perubahan berkas yang belum di-commit!${NC}"
        git status -s
        echo ""
        read -p "Masukkan pesan commit (atau tekan Enter untuk default): " COMMIT_MSG
        if [ -z "$COMMIT_MSG" ]; then
            COMMIT_MSG="build(release): release new desktop binaries via ./release TUI"
        fi
        git add .
        git commit -m "$COMMIT_MSG"
        echo -e "${GREEN}✅ Perubahan berhasil di-commit di lokal!${NC}"
    else
        echo -e "${GREEN}✅ Working tree bersih. Siap di-push!${NC}"
    fi
}

function trigger_build() {
    print_banner
    echo -e "${BOLD}${YELLOW}🚀 PILIHAN 1: PUSH & PICU BUILD GITHUB ACTIONS${NC}\n"
    check_git_status

    echo ""
    read -p "Apakah Anda yakin ingin PUSH ke origin main untuk memicu Build Desktop? [y/N]: " CONFIRM
    if [[ "$CONFIRM" =~ ^[Yy]$ ]]; then
        echo -e "\n${BLUE}⏳ Mengunggah kode ke GitHub main...${NC}"
        git push origin main
        if [ $? -eq 0 ]; then
            echo -e "\n${GREEN}🎉 PUSH BERHASIL! GitHub Actions sedang mem-build berkas .exe & .AppImage.${NC}"
            echo -e "${CYAN}💡 Anda dapat memantau build di GitHub Actions atau jalankan opsi [2] beberapa menit lagi.${NC}"
        else
            echo -e "\n${RED}❌ Gagal melakukan git push. Periksa koneksi internet Anda.${NC}"
        fi
    else
        echo -e "${YELLOW}Proses push dibatalkan.${NC}"
    fi
    read -p "Tekan [Enter] untuk kembali ke menu..."
}

function download_installers() {
    print_banner
    echo -e "${BOLD}${GREEN}📥 PILIHAN 2: UNDUH INSTALLER DESKTOP TERBARU${NC}\n"
    node scripts/download-desktop-builds.js
    echo ""
    read -p "Tekan [Enter] me-refresh daftar installer..."
}

function list_installers() {
    print_banner
    echo -e "${BOLD}${CYAN}📂 PILIHAN 3: DAFTAR BERKAS INSTALLER LOKAL (desktop-builds/)${NC}\n"
    
    if [ -d "desktop-builds" ] && [ "$(ls -A desktop-builds 2>/dev/null)" ]; then
        echo -e "${GREEN}Tersedia berkas di folder desktop-builds/:${NC}\n"
        ls -lh desktop-builds | awk 'NR>1 {print "  📦 " $9 " (" $5 ")"}'
    else
        echo -e "${YELLOW}⚠️ Folder desktop-builds/ masih kosong.${NC}"
        echo -e "Gunakan opsi [2] untuk mengunduh installer dari GitHub Actions."
    fi
    echo ""
    read -p "Tekan [Enter] untuk kembali ke menu..."
}

function check_status() {
    print_banner
    echo -e "${BOLD}${BLUE}📊 PILIHAN 4: CEK STATUS RILIS GITHUB${NC}\n"
    echo -e "${YELLOW}Mengambil data rilis publik dari GitHub REST API...${NC}"
    curl -s "https://api.github.com/repos/velora-1d/POS-Skillage/releases" | node -e '
      let data = "";
      process.stdin.on("data", c => data += c);
      process.stdin.on("end", () => {
        try {
          let json = JSON.parse(data);
          if (Array.isArray(json) && json.length > 0) {
            console.log("\n✅ Rilis Terakhir: " + json[0].name + " (" + json[0].tag_name + ")");
            console.log("   Dibuat pada: " + new Date(json[0].created_at).toLocaleString("id-ID"));
            console.log("   Total Berkas: " + (json[0].assets ? json[0].assets.length : 0) + " installer");
          } else {
            console.log("\n⚠️ Belum ada rilis yang tersedia.");
          }
        } catch(e) {
          console.log("❌ Gagal membaca API rilis.");
        }
      })
    '
    echo ""
    read -p "Tekan [Enter] untuk kembali ke menu..."
}

while true; do
    print_banner
    echo -e " ${BOLD}MENU OPSI UTAMA:${NC}"
    echo -e "  ${GREEN}[1]${NC} 🚀 Push & Picu Build GitHub Actions (Windows .exe & Linux)"
    echo -e "  ${GREEN}[2]${NC} 📥 Unduh Installer Terbaru ke Lokal (desktop-builds/)"
    echo -e "  ${GREEN}[3]${NC} 📂 Lihat Daftar Berkas Installer di Folder Lokal"
    echo -e "  ${GREEN}[4]${NC} 📊 Cek Status Rilis GitHub API"
    echo -e "  ${RED}[0]${NC} 🚪 Keluar"
    echo -e "${CYAN}========================================================================${NC}"
    read -p "Pilih opsi [0-4]: " CHOICE

    case $CHOICE in
        1) trigger_build ;;
        2) download_installers ;;
        3) list_installers ;;
        4) check_status ;;
        0) echo -e "\n${GREEN}Terima kasih! Sampai jumpa.${NC}\n"; exit 0 ;;
        *) echo -e "${RED}Pilihan tidak valid!${NC}"; sleep 1 ;;
    esac
done
