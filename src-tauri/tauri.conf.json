{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Skillage Mart POS",
  "version": "1.0.0",
  "identifier": "com.skillagemart.pos",
  "build": {
    "frontendDist": "https://pos.skillage-mart.com",
    "devUrl": "http://127.0.0.1:8000"
  },
  "app": {
    "windows": [
      {
        "title": "Skillage Mart — POS & Admin",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
