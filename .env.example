APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Fase 17-Darurat: email owner/admin yang menerima notifikasi
# kegagalan backup harian (spatie/laravel-backup) — WAJIB diisi di
# produksi.
BACKUP_NOTIFICATION_EMAIL=owner@skillagemart.test
# Kosongkan di produksi Linux biasa (mysqldump ada di PATH). Isi hanya
# kalau dev lokal Windows/Laragon, mis:
# MYSQLDUMP_BINARY_PATH="C:/laragon/bin/mysql/mysql-8.0.30-winx64/bin"
MYSQLDUMP_BINARY_PATH=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Password & PIN default akun seeder (owner/admin/kasir/dst) — ganti di produksi
SEEDER_DEFAULT_PASSWORD=password
SEEDER_DEFAULT_PIN=123456

# Integrasi Midtrans Payment Gateway
MIDTRANS_GATEWAY=
MIDTRANS_IS_PRODUCTION=false

# Kredensial Mode Production (Aktif saat MIDTRANS_IS_PRODUCTION=true)
MIDTRANS_PRODUCTION_SERVER_KEY=
MIDTRANS_PRODUCTION_CLIENT_KEY=
MIDTRANS_PRODUCTION_MERCHANT_ID=

# Kredensial Mode Sandbox (Aktif saat MIDTRANS_IS_PRODUCTION=false)
MIDTRANS_SANDBOX_SERVER_KEY=
MIDTRANS_SANDBOX_CLIENT_KEY=
MIDTRANS_SANDBOX_MERCHANT_ID=

# Integrasi Pakasir Payment Gateway
PAKASIR_API_KEY=
PAKASIR_BASE_URL=https://app.pakasir.com
PAKASIR_SLUG=
PAKASIR_CALLBACK_URL="${APP_URL}/api/v1/callback/pakasir"

